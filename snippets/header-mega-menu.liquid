                  {%- endif -%}
                  <span>Explore Activewear</span>
                </a>
                <a href="{{ sportswear_collection.url | default: routes.collections_url }}" class="coss-mega-card">
                  {%- if sportswear_collection.image != blank -%}
                    {{ sportswear_collection.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Sportswear' }}
                  {%- elsif sportswear_collection.products.first.featured_image != blank -%}
                    {{ sportswear_collection.products.first.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Sportswear' }}
                  {%- endif -%}
                  <span>Everyday Movement</span>
                </a>
              </div>
            </div>
          </div>
        </details>
      </header-menu>
    </li>

    <li>
      <header-menu>
        <details class="mega-menu coss-mega-menu coss-hover-disclosure">
          <summary class="header__menu-item list-menu__item link focus-inset">
            <span>Accessories</span>{{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="mega-menu__content coss-mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup" tabindex="-1">
            <div class="coss-mega-menu__inner page-width coss-mega-menu__inner--simple">
              <div class="coss-mega-menu__links">
                <p class="coss-mega-menu__eyebrow">Everyday Utility</p>
                <a href="{{ gym_travel.url | default: routes.collections_url }}" class="coss-mega-menu__link">Gym Towels</a>
                <a href="{{ gym_travel.url | default: routes.collections_url }}" class="coss-mega-menu__link">Laundry Care</a>
                <a href="{{ gym_travel.url | default: routes.collections_url }}" class="coss-mega-menu__link">Travel Essentials</a>
                <a href="{{ bundles_collection.url | default: routes.collections_url }}" class="coss-mega-menu__link">Accessory Bundles</a>
              </div>
              <div class="coss-mega-menu__editorial"><strong>Premium & Active Basics</strong><span>Small essentials for daily movement.</span></div>
            </div>
          </div>
        </details>
      </header-menu>
    </li>

    <li>
      <header-menu>
        <details class="mega-menu coss-mega-menu coss-hover-disclosure">
          <summary class="header__menu-item list-menu__item link focus-inset">
            <span>Bundles</span>{{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="mega-menu__content coss-mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup" tabindex="-1">
            <div class="coss-mega-menu__inner page-width coss-mega-menu__inner--simple">
              <div class="coss-mega-menu__links">
                <p class="coss-mega-menu__eyebrow">Curated Sets</p>
                <a href="{{ bundles_collection.url | default: routes.collections_url }}" class="coss-mega-menu__link">All Bundles</a>
                <a href="{{ studio_movement.url | default: routes.collections_url }}" class="coss-mega-menu__link">Studio Starter Kit</a>
                <a href="{{ football_training.url | default: routes.collections_url }}" class="coss-mega-menu__link">Football Training Kit</a>
                <a href="{{ everyday_rotation.url | default: routes.collections_url }}" class="coss-mega-menu__link">Everyday Sock Packs</a>
              </div>
              <div class="coss-mega-menu__editorial"><strong>Easy gifting, premium feel.</strong><span>Ready-to-shop packs for movement and daily rotation.</span></div>
            </div>
          </div>
        </details>
      </header-menu>
    </li>

    <li>
      <a href="{{ routes.root_url }}" class="header__menu-item list-menu__item link link--text focus-inset">
        <span>About Coss Boss</span>
      </a>
    </li>
  </ul>
</nav>

<script>
  (() => {
    const disclosures = document.querySelectorAll('[data-coss-hover-menu] details.coss-hover-disclosure');
    if (!disclosures.length) return;

    disclosures.forEach((details) => {
      let closeTimer;
      const open = () => {
        if (!window.matchMedia('(min-width: 990px)').matches) return;
        window.clearTimeout(closeTimer);
        disclosures.forEach((item) => {
          if (item !== details) item.removeAttribute('open');
        });
        details.setAttribute('open', '');
      };
      const close = () => {
        if (!window.matchMedia('(min-width: 990px)').matches) return;
        closeTimer = window.setTimeout(() => details.removeAttribute('open'), 160);
      };
      details.addEventListener('mouseenter', open);
      details.addEventListener('focusin', open);
      details.addEventListener('mouseleave', close);
      details.addEventListener('focusout', close);
    });
  })();
</script>
