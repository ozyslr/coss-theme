{% comment %}
  Coss Boss curated desktop mega menu.
  Enhanced with new Phase 4 collections and reliable desktop hover opening.
{% endcomment %}

{%- liquid
  assign performance_socks = collections['performance-socks']
  assign activewear_essentials = collections['activewear-essentials']
  assign socks_collection = collections['socks']
  assign sportswear_collection = collections['sportswear']
  assign studio_movement = collections['studio-movement']
  assign football_training = collections['football-training']
  assign everyday_rotation = collections['everyday-rotation']
  assign gym_travel = collections['gym-travel-essentials']
  assign bundles_collection = collections['bundles']
-%}

<nav class="header__inline-menu coss-header-menu" data-coss-hover-menu>
  <ul class="list-menu list-menu--inline" role="list">
    <li>
      <header-menu>
        <details class="mega-menu coss-mega-menu coss-hover-disclosure">
          <summary class="header__menu-item list-menu__item link focus-inset">
            <span>Socks</span>{{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="mega-menu__content coss-mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup" tabindex="-1">
            <div class="coss-mega-menu__inner page-width">
              <div class="coss-mega-menu__links">
                <p class="coss-mega-menu__eyebrow">Premium Socks</p>
                <a href="{{ performance_socks.url | default: routes.collections_url }}" class="coss-mega-menu__link">Performance Socks</a>
                <a href="{{ studio_movement.url | default: performance_socks.url | default: routes.collections_url }}" class="coss-mega-menu__link">Pilates Grip Socks</a>
                <a href="{{ football_training.url | default: socks_collection.url | default: routes.collections_url }}" class="coss-mega-menu__link">Football Grip Socks</a>
                <a href="{{ everyday_rotation.url | default: socks_collection.url | default: routes.collections_url }}" class="coss-mega-menu__link">Everyday Rotation</a>
                <a href="{{ bundles_collection.url | default: routes.collections_url }}" class="coss-mega-menu__link">Sock Bundles</a>
              </div>
              <div class="coss-mega-menu__cards">
                <a href="{{ studio_movement.url | default: performance_socks.url | default: routes.collections_url }}" class="coss-mega-card">
                  {%- if studio_movement.image != blank -%}
                    {{ studio_movement.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Studio Movement' }}
                  {%- elsif studio_movement.products.first.featured_image != blank -%}
                    {{ studio_movement.products.first.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Studio Movement' }}
                  {%- elsif performance_socks.products.first.featured_image != blank -%}
                    {{ performance_socks.products.first.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Studio Movement' }}
                  {%- endif -%}
                  <span>Studio Movement</span>
                </a>
                <a href="{{ football_training.url | default: socks_collection.url | default: routes.collections_url }}" class="coss-mega-card">
                  {%- if football_training.image != blank -%}
                    {{ football_training.image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Football Training' }}
                  {%- elsif football_training.products.first.featured_image != blank -%}
                    {{ football_training.products.first.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Football Training' }}
                  {%- elsif socks_collection.products.first.featured_image != blank -%}
                    {{ socks_collection.products.first.featured_image | image_url: width: 600 | image_tag: widths: '300, 450, 600', class: 'coss-mega-card__image', alt: 'Football Training' }}
                  {%- endif -%}
                  <span>Football Training</span>
                </a>
              </div>
            </div>
          </div>
        </details>
      </header-menu>
    </li>

    <li>
      <header-menu>
        <details class="mega-menu coss-mega-menu coss-hover-disclosure">
          <summary class="header__menu-item list-menu__item link focus-inset">
            <span>Activewear</span>{{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="mega-menu__content coss-mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup" tabindex="-1">
            <div class="coss-mega-menu__inner page-width">
              <div class="coss-mega-menu__links">
                <p class="coss-mega-menu__eyebrow">Active Essentials</p>
                <a href="{{ activewear_essentials.url | default: routes.collections_url }}" class="coss-mega-menu__link">Leggings</a>
                <a href="{{ activewear_essentials.url | default: routes.collections_url }}" class="coss-mega-menu__link">Shorts</a>
                <a href="{{ activewear_essentials.url | default: routes.collections_url }}" class="coss-mega-menu__link">Active Sets</a>
                <a href="{{ activewear_essentials.url | default: routes.collections_url }}" class="coss-mega-menu__link">Active Tops</a>
                <a href="{{ bundles_collection.url | default: routes.collections_url }}" class="coss-mega-menu__link">Activewear Bundles</a>
              </div>
              <div class="coss-mega-menu__cards">
                <a href="{{ activewear_essentials.url | default: routes.collections_url }}" class="coss-mega-card">
