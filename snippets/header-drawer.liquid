{% comment %}
  Coss Boss mobile accordion drawer.
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}">
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container coss-mobile-menu">
        <nav class="menu-drawer__navigation coss-mobile-menu__nav">
          <details class="coss-mobile-menu__group" open>
            <summary class="coss-mobile-menu__summary">Socks</summary>
            <div class="coss-mobile-menu__links">
              <a href="/collections/performance-socks">Performance Socks</a>
              <a href="/collections/performance-socks">Pilates Grip Socks</a>
              <a href="/collections/socks">Football Grip Socks</a>
              <a href="/collections/socks">Colorful Socks</a>
            </div>
          </details>

          <details class="coss-mobile-menu__group">
            <summary class="coss-mobile-menu__summary">Activewear</summary>
            <div class="coss-mobile-menu__links">
              <a href="/collections/activewear-essentials">Leggings</a>
              <a href="/collections/activewear-essentials">Shorts</a>
              <a href="/collections/activewear-essentials">Active Sets</a>
              <a href="/collections/activewear-essentials">Active Tops</a>
            </div>
          </details>

          <details class="coss-mobile-menu__group">
            <summary class="coss-mobile-menu__summary">Accessories</summary>
            <div class="coss-mobile-menu__links">
              <a href="/collections/all">Gym Towels</a>
              <a href="/collections/all">Laundry Care</a>
              <a href="/collections/all">Travel Essentials</a>
            </div>
          </details>

          <details class="coss-mobile-menu__group">
            <summary class="coss-mobile-menu__summary">Gift Guide</summary>
            <div class="coss-mobile-menu__links">
              <a href="/collections/performance-socks">Sock Gift Sets</a>
              <a href="/collections/socks">Colorful Multipacks</a>
              <a href="/collections/performance-socks">Studio Essentials</a>
            </div>
          </details>

          <details class="coss-mobile-menu__group">
            <summary class="coss-mobile-menu__summary">About Coss Boss</summary>
            <div class="coss-mobile-menu__links">
              <a href="/">Brand Story</a>
              <a href="/">Premium & Active Basics</a>
              <a href="/">Care Guide</a>
            </div>
          </details>
        </nav>

        <div class="coss-mobile-menu__footer">
          <p>COSS BOSS</p>
          <span>Engineered for everyday movement.</span>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<style>
  .coss-mobile-menu {
    padding: 2rem 2.2rem 3rem;
  }

  .coss-mobile-menu__nav {
    padding: 0;
  }

  .coss-mobile-menu__group {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.12);
  }

  .coss-mobile-menu__summary {
    cursor: pointer;
    padding: 1.8rem 0;
    list-style: none;
    font-size: 1.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .coss-mobile-menu__summary::-webkit-details-marker {
    display: none;
  }

  .coss-mobile-menu__summary::after {
    content: '+';
    font-size: 2.2rem;
    line-height: 1;
  }

  .coss-mobile-menu__group[open] .coss-mobile-menu__summary::after {
    content: '–';
  }

  .coss-mobile-menu__links {
    display: grid;
    gap: 0.8rem;
    padding: 0 0 1.8rem;
  }

  .coss-mobile-menu__links a {
    color: rgb(var(--color-foreground));
    text-decoration: none;
    font-size: 1.5rem;
    opacity: 0.82;
  }

  .coss-mobile-menu__footer {
    margin-top: 3rem;
    padding: 2rem;
    border-radius: 1.6rem;
    background: rgba(var(--color-foreground), 0.06);
  }

  .coss-mobile-menu__footer p {
    margin: 0 0 0.4rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    font-size: 1.2rem;
  }

  .coss-mobile-menu__footer span {
    font-size: 1.4rem;
    opacity: 0.72;
  }
</style>
