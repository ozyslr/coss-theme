{% comment %}
  Coss Boss premium hero slider.
  Uses uploaded slide images when available, then collection images, then a branded fallback panel.
{% endcomment %}

<section class="coss-hero-slider" data-coss-hero-slider>
  <div class="coss-hero-slider__media" aria-hidden="true">
    {%- for block in section.blocks -%}
      {%- liquid
        assign slide_image = block.settings.image
        if slide_image == blank and block.settings.collection != blank
          assign slide_image = block.settings.collection.image | default: block.settings.collection.products.first.featured_image
        endif
        assign slide_style = forloop.index | modulo: 4
      -%}
      <div class="coss-hero-slider__slide{% if forloop.first %} is-active{% endif %}" data-coss-slide {{ block.shopify_attributes }}>
        {%- if slide_image != blank -%}
          {{ slide_image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1500, 2200', class: 'coss-hero-slider__image', loading: 'eager', alt: block.settings.title | escape }}
        {%- else -%}
          <div class="coss-hero-slider__fallback coss-hero-slider__fallback--{{ slide_style }}">
            <div class="coss-hero-slider__fallback-copy">
              <span>COSS BOSS</span>
              <strong>{{ block.settings.title | default: 'Premium active basics' }}</strong>
              <em>Studio • Football • Everyday Rotation</em>
            </div>
            <div class="coss-hero-slider__sock-art coss-hero-slider__sock-art--one"></div>
            <div class="coss-hero-slider__sock-art coss-hero-slider__sock-art--two"></div>
            <div class="coss-hero-slider__grip-dots"></div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="coss-hero-slider__overlay"></div>

  <div class="coss-hero-slider__content page-width">
    <p class="coss-hero-slider__kicker">{{ section.settings.kicker }}</p>
    <h1 class="coss-hero-slider__heading">{{ section.settings.heading }}</h1>
    <p class="coss-hero-slider__text">{{ section.settings.text }}</p>
    <div class="coss-hero-slider__buttons">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 }}" class="button button--primary">{{ section.settings.button_label_1 }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>

  <div class="coss-hero-slider__dots" aria-label="Hero slider controls">
    {%- for block in section.blocks -%}
      <button class="coss-hero-slider__dot{% if forloop.first %} is-active{% endif %}" type="button" data-coss-dot aria-label="Show slide {{ forloop.index }}"></button>
    {%- endfor -%}
  </div>
</section>

<style>
  .coss-hero-slider {
    position: relative;
    min-height: 72rem;
    overflow: hidden;
    background: #090909;
    color: #fff;
    display: flex;
    align-items: center;
  }

  .coss-hero-slider__media,
  .coss-hero-slider__slide,
  .coss-hero-slider__overlay {
    position: absolute;
    inset: 0;
  }

  .coss-hero-slider__slide {
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 650ms ease, transform 900ms ease;
  }

  .coss-hero-slider__slide.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .coss-hero-slider__image,
  .coss-hero-slider__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .coss-hero-slider__fallback {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 72rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 80% 32%, rgba(255,255,255,0.18), transparent 18%),
      radial-gradient(circle at 65% 78%, rgba(211, 181, 130, 0.18), transparent 20%),
      linear-gradient(135deg, #050505 0%, #1d1d1b 48%, #090909 100%);
  }

  .coss-hero-slider__fallback--1 { background: radial-gradient(circle at 74% 34%, rgba(198, 172, 130, 0.22), transparent 22%), linear-gradient(135deg, #050505, #22211f 52%, #090909); }
  .coss-hero-slider__fallback--2 { background: radial-gradient(circle at 74% 34%, rgba(70, 124, 220, 0.24), transparent 22%), linear-gradient(135deg, #050505, #182033 52%, #090909); }
  .coss-hero-slider__fallback--3 { background: radial-gradient(circle at 74% 34%, rgba(180, 90, 220, 0.22), transparent 22%), linear-gradient(135deg, #050505, #231a28 52%, #090909); }
  .coss-hero-slider__fallback--0 { background: radial-gradient(circle at 74% 34%, rgba(220, 80, 90, 0.2), transparent 22%), linear-gradient(135deg, #050505, #251718 52%, #090909); }

  .coss-hero-slider__fallback-copy {
    position: absolute;
    right: clamp(4rem, 8vw, 12rem);
    top: 50%;
    transform: translateY(-50%);
    width: min(42rem, 35vw);
    z-index: 1;
  }

  .coss-hero-slider__fallback-copy span,
  .coss-hero-slider__fallback-copy em {
    display: block;
    color: rgba(255,255,255,0.72);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-style: normal;
    font-size: 1.1rem;
  }

  .coss-hero-slider__fallback-copy strong {
    display: block;
    margin: 1.4rem 0;
    color: #fff;
    font-size: clamp(3.4rem, 4.8vw, 7.2rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .coss-hero-slider__sock-art {
    position: absolute;
    border-radius: 999px 999px 180px 180px;
    background: rgba(255,255,250,0.88);
    box-shadow: 0 24px 80px rgba(0,0,0,0.35);
    transform: rotate(-14deg);
  }

  .coss-hero-slider__sock-art--one {
    width: 22rem;
    height: 58rem;
    right: 24%;
    top: 14%;
  }

  .coss-hero-slider__sock-art--two {
    width: 20rem;
    height: 52rem;
    right: 10%;
    top: 28%;
    opacity: 0.72;
    transform: rotate(12deg);
  }

  .coss-hero-slider__grip-dots {
    position: absolute;
    right: 21%;
    bottom: 20%;
    width: 22rem;
    height: 14rem;
    opacity: 0.6;
    background-image: radial-gradient(circle, rgba(0,0,0,0.42) 0 0.45rem, transparent 0.48rem);
    background-size: 3rem 3rem;
    transform: rotate(-14deg);
  }

  .coss-hero-slider__overlay {
    background:
      radial-gradient(circle at 72% 40%, rgba(255,255,255,0.14), transparent 26%),
      linear-gradient(90deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.66) 42%, rgba(0,0,0,0.24) 100%);
  }

  .coss-hero-slider__content {
    position: relative;
    z-index: 2;
    max-width: 74rem;
    margin-left: 0;
    padding-top: 8rem;
    padding-bottom: 8rem;
  }

  .coss-hero-slider__kicker {
    margin: 0 0 1.4rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-size: 1.2rem;
    color: rgba(255,255,255,0.72);
  }

  .coss-hero-slider__heading {
    margin: 0;
    color: #fff;
    font-size: clamp(4.4rem, 7vw, 9.6rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .coss-hero-slider__text {
    max-width: 56rem;
    margin: 2rem 0 0;
    color: rgba(255,255,255,0.78);
    font-size: 1.9rem;
    line-height: 1.55;
  }

  .coss-hero-slider__buttons {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }

  .coss-hero-slider__dots {
    position: absolute;
    left: 50%;
    bottom: 2.4rem;
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    gap: 0.8rem;
  }

  .coss-hero-slider__dot {
    width: 3rem;
    height: 0.3rem;
    border: 0;
    background: rgba(255,255,255,0.35);
    padding: 0;
    cursor: pointer;
  }

  .coss-hero-slider__dot.is-active { background: #fff; }

  @media screen and (max-width: 749px) {
    .coss-hero-slider { min-height: 62rem; }
    .coss-hero-slider__fallback { min-height: 62rem; }
    .coss-hero-slider__overlay { background: linear-gradient(180deg, rgba(0,0,0,0.76), rgba(0,0,0,0.86)); }
    .coss-hero-slider__content { padding-top: 6rem; padding-bottom: 7rem; }
    .coss-hero-slider__heading { font-size: clamp(4rem, 14vw, 6.2rem); }
    .coss-hero-slider__text { font-size: 1.6rem; }
    .coss-hero-slider__fallback-copy { display: none; }
    .coss-hero-slider__sock-art--one { right: 18%; top: 18%; }
    .coss-hero-slider__sock-art--two { right: -4%; top: 34%; }
  }
</style>

<script>
  (() => {
    const sliders = document.querySelectorAll('[data-coss-hero-slider]');
    sliders.forEach((slider) => {
      const slides = Array.from(slider.querySelectorAll('[data-coss-slide]'));
      const dots = Array.from(slider.querySelectorAll('[data-coss-dot]'));
      if (slides.length <= 1) return;

      let index = 0;
      const showSlide = (nextIndex) => {
        index = nextIndex % slides.length;
        slides.forEach((slide, slideIndex) => slide.classList.toggle('is-active', slideIndex === index));
        dots.forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === index));
      };

      dots.forEach((dot, dotIndex) => {
        dot.addEventListener('click', () => showSlide(dotIndex));
      });

      setInterval(() => showSlide(index + 1), 5000);
    });
  })();
</script>

{% schema %}
{
  "name": "Coss hero slider",
  "tag": "section",
  "class": "section section-coss-hero-slider",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "COSS BOSS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered for everyday movement" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Premium socks and active essentials for everyday movement." },
    { "type": "text", "id": "button_label_1", "label": "First button label", "default": "Shop Performance Socks" },
    { "type": "url", "id": "button_link_1", "label": "First button link", "default": "/collections/performance-socks" },
    { "type": "text", "id": "button_label_2", "label": "Second button label", "default": "Explore Active Essentials" },
    { "type": "url", "id": "button_link_2", "label": "Second button link", "default": "/collections/activewear-essentials" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Fallback collection image" },
        { "type": "text", "id": "title", "label": "Image alt text", "default": "Coss Boss active essentials" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coss hero slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
